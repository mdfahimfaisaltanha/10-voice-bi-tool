# --- Required ---

# Postgres connection string. Free options: Neon (neon.tech) or Supabase.
# Example (Neon): postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# OpenAI API key for natural-language-to-SQL translation.
OPENAI_API_KEY=

# --- Optional ---

# Chat model for NL-to-SQL (default: gpt-4o-mini)
OPENAI_MODEL=
